#!/bin/sh
#
# Kernel knobs for a single-core battery player, set once at boot.
#
# Each one is written only if the file exists, so a kernel built without the
# feature just keeps its default and the boot goes on. Nothing here is needed
# to boot: removing this file gives the stock behaviour back.

case "$1" in
  start)
	;;
  stop|restart|reload)
	exit 0
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

knob() { [ -e "$1" ] && echo "$2" > "$1" 2>/dev/null; }

# Only errors reach the serial console. A UART console prints synchronously,
# with the CPU waiting on every byte, so a chatty driver costs the player
# cycles; dmesg still keeps every level.
knob /proc/sys/kernel/printk "4 4 1 7"

# The flusher wakes every 15 s instead of every 5 s while there is dirty data,
# so small writes (database, settings, logs) leave in fewer, larger batches.
# The age at which data must be written (dirty_expire, 30 s) is unchanged, and
# every power-off, reboot and suspend path in the player calls sync() first.
knob /proc/sys/vm/dirty_writeback_centisecs 1500

# The microSD. cfq is built for seeking disks: per-process queues and timers
# that buy nothing on flash. deadline is as cheap as noop and still serves the
# audio stream's reads ahead of the library's writes; noop if it is missing.
# A bigger readahead turns a track into fewer, larger reads, so the card and
# the CPU sit idle longer between them.
# shortcut: only the cards present at boot get this; one inserted later keeps
# the kernel defaults. An mdev.conf rule for mmcblk would cover hotplug.
for q in /sys/block/mmcblk*/queue; do
	[ -d "$q" ] || continue
	knob "$q/scheduler" deadline || knob "$q/scheduler" noop
	knob "$q/read_ahead_kb" 512
done

exit 0
